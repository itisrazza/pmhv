{
  "openapi": "3.1.0",
  "info": {
    "title": "pmhv",
    "description": "Poor Man's HyperVisor daemon API",
    "contact": {
      "name": "Rareș Nistor",
      "email": "raresh@nistor.email"
    },
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs in with the password (or the temporary one, which only allows setting a password).",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in; the session cookie is set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            }
          },
          "401": {
            "description": "Wrong password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out; the session cookie is cleared"
          }
        }
      }
    },
    "/api/v1/auth/password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sets the password. Other sessions are signed out.",
        "operationId": "setPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Password set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            }
          },
          "422": {
            "description": "Password too short",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Whether this browser is signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/host": {
      "get": {
        "tags": [
          "host"
        ],
        "summary": "Facts about the host pmhvd runs on.",
        "operationId": "getHost",
        "responses": {
          "200": {
            "description": "Host facts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HostInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images": {
      "get": {
        "tags": [
          "images"
        ],
        "operationId": "listImages",
        "responses": {
          "200": {
            "description": "Storage groups and their images",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ImageGroup"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "images"
        ],
        "operationId": "createImage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateImageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageRef"
                }
              }
            }
          },
          "409": {
            "description": "An image with that name exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/{group}/{name}": {
      "put": {
        "tags": [
          "images"
        ],
        "summary": "Uploads an image file as the request body. Existing images aren't replaced.",
        "operationId": "uploadImage",
        "parameters": [
          {
            "name": "group",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageRef"
                }
              }
            }
          },
          "409": {
            "description": "An image with that name exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "images"
        ],
        "summary": "Deletes an image that no machine has attached.",
        "operationId": "deleteImage",
        "parameters": [
          {
            "name": "group",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "409": {
            "description": "A machine uses it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/{group}/{name}/convert": {
      "post": {
        "tags": [
          "images"
        ],
        "summary": "Starts converting an image into a new one in the same group, as a job.",
        "operationId": "convertImage",
        "parameters": [
          {
            "name": "group",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConvertImageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Started; progress follows on the event stream",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "409": {
            "description": "A running machine uses it, or the target exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/{group}/{name}/resize": {
      "post": {
        "tags": [
          "images"
        ],
        "operationId": "resizeImage",
        "parameters": [
          {
            "name": "group",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResizeImageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Resized"
          },
          "409": {
            "description": "A running machine uses it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Would shrink, or it's an ISO",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "operationId": "listJobs",
        "responses": {
          "200": {
            "description": "Jobs since pmhvd started, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Job"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/machines": {
      "get": {
        "tags": [
          "machines"
        ],
        "operationId": "listMachines",
        "responses": {
          "200": {
            "description": "All machines, by name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Machine"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "machines"
        ],
        "operationId": "createMachine",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMachineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Machine"
                }
              }
            }
          },
          "422": {
            "description": "Invalid spec",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/machines/{id}": {
      "get": {
        "tags": [
          "machines"
        ],
        "operationId": "getMachine",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Machine ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The machine",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Machine"
                }
              }
            }
          },
          "404": {
            "description": "No such machine",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "machines"
        ],
        "summary": "Replaces a machine's spec. Only notes can change while it's running.",
        "operationId": "updateMachine",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Machine ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MachineSpec"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Machine"
                }
              }
            }
          },
          "409": {
            "description": "The machine isn't stopped",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid spec",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "machines"
        ],
        "summary": "Deletes a stopped machine. Its disk images stay in the image store.",
        "operationId": "deleteMachine",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Machine ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "409": {
            "description": "The machine isn't stopped",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/machines/{id}/power": {
      "post": {
        "tags": [
          "machines"
        ],
        "operationId": "powerMachine",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Machine ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PowerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Action accepted; state changes follow on the event stream",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Machine"
                }
              }
            }
          },
          "409": {
            "description": "Not possible in the machine's current state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "The machine couldn't start or refused the action",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/preferences": {
      "get": {
        "tags": [
          "preferences"
        ],
        "operationId": "getPreferences",
        "responses": {
          "200": {
            "description": "The web UI's settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "preferences"
        ],
        "operationId": "setPreferences",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "Body of every non-2xx API response.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable, machine-readable error code, e.g. `not_found`."
          },
          "message": {
            "type": "string",
            "description": "Human-readable description of what went wrong."
          }
        }
      },
      "Arch": {
        "type": "string",
        "enum": [
          "aarch64",
          "x86_64"
        ]
      },
      "AuthStatus": {
        "type": "object",
        "required": [
          "authenticated",
          "setup_required"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "setup_required": {
            "type": "boolean",
            "description": "Signed in with the temporary password: a password has to be set before anything else."
          }
        }
      },
      "Backend": {
        "type": "string",
        "enum": [
          "qemu",
          "vz"
        ]
      },
      "ConsoleKind": {
        "type": "string",
        "enum": [
          "text",
          "graphical"
        ]
      },
      "ConvertImageRequest": {
        "type": "object",
        "required": [
          "format",
          "name"
        ],
        "properties": {
          "format": {
            "$ref": "#/components/schemas/ImageFormat"
          },
          "name": {
            "type": "string",
            "description": "Name of the new image, in the same group."
          }
        }
      },
      "CreateImageRequest": {
        "type": "object",
        "description": "A new, empty qcow2 image.",
        "required": [
          "group",
          "name",
          "size_gib"
        ],
        "properties": {
          "group": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "File name, ending in `.qcow2`."
          },
          "size_gib": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "CreateMachineRequest": {
        "type": "object",
        "required": [
          "spec"
        ],
        "properties": {
          "new_boot_disk": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/NewDisk",
                "description": "Create a blank boot disk in the default image group and attach it first."
              },
              {
                "type": "null"
              }
            ]
          },
          "spec": {
            "$ref": "#/components/schemas/MachineSpec"
          }
        }
      },
      "DiskBus": {
        "type": "string",
        "enum": [
          "virtio",
          "nvme",
          "sata",
          "usb"
        ]
      },
      "DiskMedia": {
        "type": "string",
        "enum": [
          "disk",
          "cdrom"
        ]
      },
      "DiskSpec": {
        "type": "object",
        "required": [
          "image",
          "bus",
          "media"
        ],
        "properties": {
          "bus": {
            "$ref": "#/components/schemas/DiskBus"
          },
          "image": {
            "$ref": "#/components/schemas/ImageRef"
          },
          "media": {
            "$ref": "#/components/schemas/DiskMedia"
          },
          "read_only": {
            "type": "boolean"
          }
        }
      },
      "Event": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "machine",
              "type"
            ],
            "properties": {
              "machine": {
                "$ref": "#/components/schemas/Machine"
              },
              "type": {
                "type": "string",
                "enum": [
                  "machine_updated"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "machine_removed"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "job",
              "type"
            ],
            "properties": {
              "job": {
                "$ref": "#/components/schemas/Job"
              },
              "type": {
                "type": "string",
                "enum": [
                  "job_updated"
                ]
              }
            }
          }
        ],
        "description": "Pushed to clients on the event stream."
      },
      "Firmware": {
        "type": "string",
        "enum": [
          "uefi",
          "bios"
        ]
      },
      "GuestOs": {
        "type": "string",
        "enum": [
          "linux",
          "macos",
          "windows",
          "other"
        ]
      },
      "HostInfo": {
        "type": "object",
        "description": "Facts about the machine pmhvd is running on.",
        "required": [
          "version",
          "os",
          "arch"
        ],
        "properties": {
          "arch": {
            "type": "string",
            "description": "Host CPU architecture, as Rust names it (`aarch64`, `x86_64`)."
          },
          "os": {
            "type": "string",
            "description": "Host operating system, as Rust names it (`macos`, `linux`, `windows`)."
          },
          "version": {
            "type": "string",
            "description": "pmhvd version."
          }
        }
      },
      "ImageFormat": {
        "type": "string",
        "enum": [
          "qcow2",
          "raw",
          "iso"
        ]
      },
      "ImageGroup": {
        "type": "object",
        "required": [
          "name",
          "images"
        ],
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageInfo"
            }
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ImageInfo": {
        "type": "object",
        "required": [
          "group",
          "name",
          "format",
          "allocated_bytes",
          "virtual_bytes",
          "used_by"
        ],
        "properties": {
          "allocated_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Space used on the host.",
            "minimum": 0
          },
          "format": {
            "$ref": "#/components/schemas/ImageFormat"
          },
          "group": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "used_by": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageUser"
            },
            "description": "Machines with this image attached."
          },
          "virtual_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Size the guest sees.",
            "minimum": 0
          }
        }
      },
      "ImageRef": {
        "type": "object",
        "description": "An image in one of pmhv's storage groups.",
        "required": [
          "group",
          "name"
        ],
        "properties": {
          "group": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ImageUser": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Job": {
        "type": "object",
        "description": "Long-running work, such as converting an image. Progress arrives on the event stream.",
        "required": [
          "id",
          "description",
          "state",
          "progress"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "What's being done, for display."
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "progress": {
            "type": "number",
            "format": "float",
            "description": "From 0 to 1."
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          }
        }
      },
      "JobState": {
        "type": "string",
        "enum": [
          "running",
          "succeeded",
          "failed"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "Machine": {
        "type": "object",
        "required": [
          "id",
          "spec",
          "state",
          "emulated"
        ],
        "properties": {
          "emulated": {
            "type": "boolean",
            "description": "True when the guest architecture differs from the host's, so it runs under emulation."
          },
          "id": {
            "type": "string"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the machine last stopped, if it didn't stop cleanly."
          },
          "spec": {
            "$ref": "#/components/schemas/MachineSpec"
          },
          "state": {
            "$ref": "#/components/schemas/MachineState"
          },
          "thumbnail": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Thumbnail",
                "description": "The most recent capture of the machine's screen, if there's been one."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "MachineSpec": {
        "type": "object",
        "description": "Everything needed to run a machine. Stored as `machine.toml`.",
        "required": [
          "name",
          "guest_os",
          "backend",
          "arch",
          "firmware",
          "cpu_cores",
          "memory_mib",
          "network",
          "console"
        ],
        "properties": {
          "arch": {
            "$ref": "#/components/schemas/Arch"
          },
          "backend": {
            "$ref": "#/components/schemas/Backend"
          },
          "console": {
            "$ref": "#/components/schemas/ConsoleKind"
          },
          "cpu_cores": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "disks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiskSpec"
            }
          },
          "firmware": {
            "$ref": "#/components/schemas/Firmware"
          },
          "guest_os": {
            "$ref": "#/components/schemas/GuestOs"
          },
          "memory_mib": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "network": {
            "$ref": "#/components/schemas/NetworkSpec"
          },
          "notes": {
            "type": "string"
          },
          "tpm": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "MachineState": {
        "type": "string",
        "enum": [
          "stopped",
          "starting",
          "running",
          "paused",
          "stopping"
        ]
      },
      "NetworkSpec": {
        "type": "string",
        "enum": [
          "none",
          "nat"
        ]
      },
      "NewDisk": {
        "type": "object",
        "required": [
          "size_gib",
          "bus"
        ],
        "properties": {
          "bus": {
            "$ref": "#/components/schemas/DiskBus"
          },
          "size_gib": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "PowerAction": {
        "type": "string",
        "enum": [
          "start",
          "stop",
          "force_stop",
          "reset",
          "pause",
          "resume"
        ]
      },
      "PowerRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/PowerAction"
          }
        }
      },
      "Preferences": {
        "type": "object",
        "description": "The web UI's settings, kept by pmhvd so they follow the user between browsers.",
        "properties": {
          "favourites": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Machines pinned to the sidebar, in order.",
            "default": []
          }
        }
      },
      "ResizeImageRequest": {
        "type": "object",
        "description": "Grows an image. Shrinking isn't offered: it truncates whatever the guest stored at the end.",
        "required": [
          "size_gib"
        ],
        "properties": {
          "size_gib": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "SetPasswordRequest": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "Thumbnail": {
        "type": "object",
        "required": [
          "kind",
          "captured_at"
        ],
        "properties": {
          "captured_at": {
            "type": "integer",
            "format": "int64",
            "description": "When it was captured, in milliseconds since the Unix epoch. Changes with every capture.",
            "minimum": 0
          },
          "kind": {
            "$ref": "#/components/schemas/ThumbnailKind"
          }
        }
      },
      "ThumbnailKind": {
        "type": "string",
        "enum": [
          "image",
          "text"
        ]
      }
    }
  }
}
